# ===================== Study Buddy (PC with RTX 3090, NUC backup) =====================
# Local LLMs only. No Gemini / cloud AI. Chat/solve: PC Ollama -> NUC Ollama (WireGuard) -> offline rules engine.
PORT="3100"
HOST="127.0.0.1"                  # keep loopback; cloudflared connects locally
TRUST_PROXY="loopback"
NODE_ENV="production"

# ---- Ollama ----
LLM_PROVIDER="ollama"              # local-edge | ollama | custom-server
OLLAMA_URL="http://127.0.0.1:11434"   # PC Ollama; never expose publicly
OLLAMA_TOKEN=""                    # Bearer token if Ollama sits behind a token proxy
OLLAMA_MODEL="gemma3:12b"
OLLAMA_VISION_MODEL="gemma3:12b"
OLLAMA_FALLBACK_URL="http://10.7.0.1:11434"   # NUC backup, WireGuard only
OLLAMA_FALLBACK_MODEL="qwen2.5:1.5b"
OLLAMA_FALLBACK_TOKEN=""
OLLAMA_TIMEOUT_MS="240000"
OLLAMA_EMPTY_RETRY="1"             # retry once (think=false) when a model returns an empty reply
OLLAMA_KEEP_ALIVE="-1"

# ---- Access ----
ADMIN_EMAIL="hashflow67@gmail.com"
GEV_URL="https://gev.vicenvalor.com"
# Cloudflare Access JWT check (recommended once the tunnel is live):
CF_ACCESS_TEAM_DOMAIN=""           # e.g. yourteam.cloudflareaccess.com
CF_ACCESS_AUD=""                   # Access application AUD tag
TRUST_CF_ACCESS_HEADER="false"     # only if the JWT check isn't configured AND the app is loopback-only
# Optional: add redeemed guests to the Access policy (keep the token OUT of the repo)
CF_API_TOKEN=""
CF_ACCOUNT_ID=""
CF_ACCESS_APP_ID=""
CF_ACCESS_POLICY_ID=""
# Local-dev sign-in fallback (loopback only, refused through the tunnel). Turn off in production.
DEV_LOGIN="false"
ADMIN_TOKEN=""                     # >=16 chars; required for admin dev-login and /api/llm/select|test
SESSION_SECRET=""                  # optional; >=32 chars (auto-generated in data/access.json otherwise)
DATA_DIR=""                        # default ./data

# ---- Limits ----
RATE_LIMIT_PER_MIN="30"
REDEEM_RATE_LIMIT="5"              # guest-code tries per 15 min
MAX_UPLOAD_MB="10"
BODY_LIMIT="18mb"
PHOTO_MIN_STDDEV="6"               # blank-photo threshold
# Admin-only GEV tool: SEEKER LLM feed (GET only, PC wg IP allowlisted, 60/min upstream).
GEV_API_URL="http://10.7.0.1:4173/llm/v1"
GEV_API_PER_MIN="50"
OLLAMA_WARMUP="true"
OLLAMA_WARM_EVERY_S="600"
MAX_UPLOAD_MB="7"

# Kawaii Me cartridge (local ComfyUI on the 3090; unset = shows "not installed")
# KAWAII_COMFY_URL=http://127.0.0.1:8188
# KAWAII_COMFY_INPUT_DIR=G:\path\to\ComfyUI\input
# KAWAII_CHECKPOINT=sd_xl_base_1.0.safetensors
# KAWAII_LORA=chibi_sdxl.safetensors
# KAWAII_IPADAPTER=ip-adapter-plus-face_sdxl_vit-h.safetensors
# KAWAII_CLIP_VISION=CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors
